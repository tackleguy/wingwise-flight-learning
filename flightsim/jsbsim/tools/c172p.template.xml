    <ground_reactions>
        <contact type="BOGEY" name="NOSE">
            <location unit="IN">
                <x> -6.8 </x>
                <y> 0 </y>
                <z> -19.5</z>
            </location>
            <static_friction> 0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <rolling_friction> 0.02 </rolling_friction>
            <spring_coeff unit="LBS/FT"> 1800 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 600 </damping_coeff>
            <max_steer unit="DEG"> 30 </max_steer>   <!-- TeachX: was 10 (see the Nose Wheel Steering channel) -->
            <brake_group> NONE </brake_group>
            <retractable>0</retractable>
            <!-- TeachX: side grip of the tyre vs slip angle (deg). Same shape as JSBSim's built-in
                 curve with a peak of 0.8; given explicitly so that static_friction (which JSBSim
                 also uses as the brake friction) can be set for realistic braking. -->
            <table name="CORNERING_COEFF" type="internal">
                <tableData>
@CORNERING@
                </tableData>
            </table>
        </contact>
        <contact type="BOGEY" name="LEFT_MAIN">
            <location unit="IN">
                <x> 58.2 </x>
                <y> -43 </y>
                <z> -15.5 </z>
            </location>
            <static_friction> @BRAKE_MU@ </static_friction>   <!-- TeachX: was 0.8; this is the full-brake friction -->
            <dynamic_friction> 0.5 </dynamic_friction>
            <rolling_friction> 0.02 </rolling_friction>
            <spring_coeff unit="LBS/FT"> 5400 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 1600 </damping_coeff>
            <max_steer unit="DEG"> 0.0 </max_steer>
            <brake_group> LEFT </brake_group>
            <retractable>0</retractable>
            <!-- TeachX: side grip of the tyre vs slip angle (deg). Same shape as JSBSim's built-in
                 curve with a peak of 0.8; given explicitly so that static_friction (which JSBSim
                 also uses as the brake friction) can be set for realistic braking. -->
            <table name="CORNERING_COEFF" type="internal">
                <tableData>
@CORNERING@
                </tableData>
            </table>
        </contact>
        <contact type="BOGEY" name="RIGHT_MAIN">
            <location unit="IN">
                <x> 58.2 </x>
                <y> 43 </y>
                <z> -15.5 </z>
            </location>
            <static_friction> @BRAKE_MU@ </static_friction>   <!-- TeachX: was 0.8; this is the full-brake friction -->
            <dynamic_friction> 0.5 </dynamic_friction>
            <rolling_friction> 0.02 </rolling_friction>
            <spring_coeff unit="LBS/FT"> 5400 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 1600 </damping_coeff>
            <max_steer unit="DEG"> 0.0 </max_steer>
            <brake_group> RIGHT </brake_group>
            <retractable>0</retractable>
