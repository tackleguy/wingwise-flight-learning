</product>
</function>
<output>inertia/pointmass-weight-lbs[11]</output>
</fcs_function>
<fcs_function name="systems/armament/drop-tank[1]/weight">
<function>
<product>
<property>/ai/submodels/submodel[21]/count</property>
<value> 50 </value>
</product>
</function>
<output>inertia/pointmass-weight-lbs[12]</output>
</fcs_function>
</channel>
</system>
