0.1250 0.5418
0.1400 0.3819
0.1600 0.1949
0.1800 0.0495
0.2000 0.0000
</tableData>
</table>
<!-- Share of the fuel's heat reaching the exhaust against equivalence ratio: makes the
exhaust gas temperature peak at the chemically correct mixture. -->
<table name="COMBUSTION" type="internal">
<tableData>
