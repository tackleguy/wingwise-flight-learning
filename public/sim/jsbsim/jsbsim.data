<function name="aero/function/outer-dalpha-rad">
<description>TeachX: how much rolling, sideslip and aileron change the angle of attack of the RIGHT outer wing panel (10.36 ft from the centreline); the left panel gets the opposite.</description>
<sum>
<atan2>
<product>
<property>velocities/p-aero-rad_sec</property>
<value>10.364</value>
</product>
<property>aero/function/v-safe-fps</property>
</atan2>
<property>aero/function/panel-dihedral-rad</property>
<product>
<value>-0.2000</value>
<property>aero/function/aileron-mean-rad</property>
</product>
</sum>
</function>
<function name="aero/function/outer-dv">
