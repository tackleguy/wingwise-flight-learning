<location unit="IN">
<x> -174.4 </x>
<y> -65.0 </y>
<z> 5.0 </z>
</location>
<capacity unit="LBS"> 3486 </capacity>
<contents unit="LBS"> 1500 </contents>
</tank>
<tank type="FUEL"> <!-- External Tank number 0 (station 4) -->
<location unit="IN">
<x> -174.4 </x>
