1.0472 -0.2165
1.5708 -0.2500
2.3562 -0.1768
3.1416 0.0000
</tableData>
</table>
</product>
</function>
<function name="aero/coefficient/Cnda">
<description>Yaw_moment_due_to_aileron (adverse yaw)</description>
<product>
<property>aero/qbar-psf</property>
<property>metrics/Sw-sqft</property>
<property>metrics/bw-ft</property>
<property>aero/function/aileron-mean-rad</property>
<value>-0.0120</value>
</product>
</function>
<function name="aero/coefficient/Cndr">
<description>Yaw_moment_due_to_rudder</description>
<product>
<property>aero/function/qbar-tail-psf</property>
<property>metrics/Sw-sqft</property>
<property>metrics/bw-ft</property>
<property>aero/function/kfin</property>
<property>fcs/rudder-pos-rad</property>
<value>-0.0657</value>
</product>
</function>
<function name="aero/coefficient/Cnwing">
<description>TeachX: yawing moment from unequal chordwise force of the left and right wing panels (yaw due to roll rate in normal flight; yaw toward a stalled wing)</description>
<product>
<property>aero/qbar-psf</property>
<property>metrics/Sw-sqft</property>
<property>metrics/bw-ft</property>
<sum>
<product>
<value>0.02413</value>
<difference>
<property>aero/function/axial-inner-right</property>
<property>aero/function/axial-inner-left</property>
</difference>
</product>
<product>
<value>0.07237</value>
<difference>
<property>aero/function/axial-outer-right</property>
<property>aero/function/axial-outer-left</property>
</difference>
</product>
</sum>
</product>
</function>
<function name="aero/coefficient/Cnswirl">
<description>TeachX: spiralling propeller slipstream striking the left side of the fin and rear fuselage: nose-left yawing moment proportional to engine torque</description>
<product>
<property>aero/function/engine-torque-ftlb</property>
<property>aero/function/slipstream-immersion</property>
<value>-2.0000</value>
</product>
</function>
<function name="aero/coefficient/Cnrig">
<description>TeachX: fixed rudder tab that balances the slipstream in cruise</description>
<product>
<property>aero/function/qbar-tail-psf</property>
<property>metrics/Sw-sqft</property>
<property>metrics/bw-ft</property>
<property>aero/function/krig</property>
<value>0.001711</value>
</product>
</function>
</axis>
</aerodynamics>
