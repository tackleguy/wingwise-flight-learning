</max>
</quotient>
</function>
<function name="aero/function/slipstream-immersion">
<description>TeachX: how much of the fin sits inside the propeller slipstream (0.1 to 1). The slipstream narrows most when the aircraft is standing still at high power (radius ratio = sqrt((V+w)/(V+2w)), w = induced velocity), and the fin root is about 0.68 propeller radii above the thrust line, so the fin is hardly touched at the start of the take-off roll and well inside by climb speed.</description>
<max>
<value>0.1</value>
<min>
<value>1.0</value>
<quotient>
<difference>
<pow>
<quotient>
<max>
<sum>
<property>velocities/u-aero-fps</property>
<property>propulsion/engine/prop-induced-velocity_fps</property>
</sum>
<value>0.5</value>
</max>
<max>
<sum>
<property>velocities/u-aero-fps</property>
<property>propulsion/engine/prop-induced-velocity_fps</property>
<property>propulsion/engine/prop-induced-velocity_fps</property>
</sum>
<value>1.0</value>
</max>
</quotient>
<value>0.5</value>
</pow>
<value>0.68</value>
</difference>
<value>0.32</value>
</quotient>
</min>
</max>
</function>
